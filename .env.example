DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=
# Flutter Android does not use CORS. Set only if you host a Flutter Web client.
CORS_ALLOWED_ORIGINS=
# Example: https://your-service-name.onrender.com
CSRF_TRUSTED_ORIGINS=
# Optional, recommended for persistent product/category/promotion image uploads on Render.
CLOUDINARY_URL=
SECURE_SSL_REDIRECT=false

